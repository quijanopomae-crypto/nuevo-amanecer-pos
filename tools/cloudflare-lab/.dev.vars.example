# Copiar a .dev.vars (ignorado por git) y usar valores aleatorios largos y distintos.
# DEVICE_CREDENTIAL_PEPPER solo existe en el Worker; las credenciales se provisionan
# en D1 como HMAC-SHA-256(pepper, credencial), nunca en texto plano.
DEVICE_CREDENTIAL_PEPPER=replace-with-a-random-server-only-pepper
READ_TOKEN=replace-with-a-distinct-read-secret

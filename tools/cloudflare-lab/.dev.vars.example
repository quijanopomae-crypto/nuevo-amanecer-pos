# Copiar a .dev.vars (ignorado por git) y usar valores aleatorios largos y distintos.
# Estos valores pertenecen al Worker LAB. No usar aquí credenciales administrativas Cloudflare.

# Hash de credenciales de dispositivos LAB. Debe ser independiente de cualquier token R2.
DEVICE_CREDENTIAL_PEPPER=replace-with-64-hex-random-server-only-pepper

# Lectura del gateway LAB; nunca autoriza escrituras.
READ_TOKEN=replace-with-a-distinct-read-secret

# Firma/verificación del pipeline CANON -> LAB. Debe ser distinto del token R2 y del pepper.
LAB_IMPORT_HMAC_SECRET=replace-with-a-distinct-random-import-secret

# R2_CANON_READ_TOKEN NO es un secreto del Worker.
# Solo se entrega al proceso GitHub Actions/CLI que ejecuta fetch-latest-canon-backup.mjs.

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nuevo-amanecer-sync-lab",
  "main": "src/worker-entry.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "build": {
    "command": "node scripts/build-reader.mjs"
  },
  "assets": {
    "directory": ".reader-assets",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": [
      "/health",
      "/commands/*",
      "/imports/*",
      "/read/*",
      "/sync/*"
    ]
  },
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nuevo-amanecer-lab",
      "database_id": "e734e6f1-41c4-4bfa-ab1f-5acbcdd2272e",
      "migrations_dir": "../../infra/database/migrations"
    }
  ],
  "vars": {
    "RUNTIME_ENVIRONMENT": "lab",
    "DATA_POLICY": "lab-only"
  }
}

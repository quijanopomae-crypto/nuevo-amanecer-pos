{
  "schema_version": 2,
  "name": "Nuevo Amanecer Laboratorio",
  "laboratory_path": "laboratorio/",
  "canonical_product_path": "POS/",
  "production_data_allowed": false,
  "isolated_canon_copy_in_d1_lab_allowed": true,
  "real_commercial_data_versioning_allowed": false,
  "production_credentials_allowed": false,
  "encrypted_ci_secrets_allowed": true,
  "credentials_versioned_or_client_exposed_allowed": false,
  "production_writes_allowed": false,
  "canonical_runtime_dependency_on_lab_allowed": false,
  "required_branch_prefix": "lab/",
  "promotion_mode": "reviewed-minimal-patch",
  "promotion_requires": [
    "tests_pass",
    "diff_reviewed",
    "rollback_defined",
    "no_real_commercial_data_versioned",
    "no_production_credentials_in_repo_or_client",
    "no_production_writes"
  ]
}
